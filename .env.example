# Required
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Image Generation (optional — set MOCK_IMAGES=true to use placeholders)
OPENAI_API_KEY=your_openai_api_key_for_dalle
MOCK_IMAGES=true

# CRM (optional — stubs for now)
GOHIGHLEVEL_API_KEY=
HUBSPOT_API_KEY=

# Trend Research (optional)
PINTEREST_API_KEY=
TWITTER_API_KEY=

# Fulfillment (optional)
PRINTFUL_API_KEY=

# Tracking Pixels (optional — auto-injected into generated pages)
META_PIXEL_ID=
TIKTOK_PIXEL_ID=
GOOGLE_ANALYTICS_ID=
PINTEREST_TAG_ID=

# Server
PORT=3001
NODE_ENV=development
