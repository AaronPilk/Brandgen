# ─── Required ───
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Image Generation (optional) ───
OPENAI_API_KEY=your_openai_api_key_for_dalle
MOCK_IMAGES=true

# ─── OAuth Connections (register developer apps on each platform) ───
# Meta (Facebook + Instagram + Meta Ads)
META_CLIENT_ID=
META_CLIENT_SECRET=

# Meta Ads API (System User Token — for managing ad campaigns)
META_SYSTEM_USER_TOKEN=
META_AD_ACCOUNT_ID=

# TikTok
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# Pinterest
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# X (Twitter)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Google (Drive, Docs)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Canva
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# GoHighLevel CRM
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=

# HubSpot CRM
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Shopify
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# WordPress
WORDPRESS_CLIENT_ID=
WORDPRESS_CLIENT_SECRET=

# Arcads (AI UGC Video Generation)
ARCADS_CLIENT_ID=
ARCADS_CLIENT_SECRET=

# Kinsta (Hosting & Deployment)
KINSTA_API_KEY=
KINSTA_COMPANY_ID=

# ZoomInfo (Lead Enrichment)
ZOOMINFO_CLIENT_ID=
ZOOMINFO_CLIENT_SECRET=

# ─── Fulfillment (API key) ───
PRINTFUL_API_KEY=

# ─── Tracking Pixels (just paste IDs) ───
META_PIXEL_ID=
TIKTOK_PIXEL_ID=
GOOGLE_ANALYTICS_ID=
PINTEREST_TAG_ID=

# ─── Server ───
PORT=3001
NODE_ENV=development
BASE_URL=http://localhost:3001
CLIENT_URL=http://localhost:5173
